{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "portfolio-web",
	"compatibility_date": "2026-10-01",
	"workers_dev": false,
	"assets": {
		"directory": "./out",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash",
	},
	"routes": [
		{
			"pattern": "danifer.dev/*",
			"zone_name": "danifer.dev",
		},
	],
}
